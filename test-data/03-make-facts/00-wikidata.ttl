wdv:c2a949c9af32533b2e84ae206053067e a wikibase:QuantityValue ;
        wikibase:quantityAmount "200"^^xsd:decimal ;
        wikibase:quantityUnit <http://www.wikidata.org/entity/Q174789> .
		
# Animals become instances of taxon
wd:Q_tiger wdt:P171 wd:Q_cat ;
    wdt:P1034 wd:Q_sheep ; 
	schema:name "tiger"@en .

# People should become people    
wd:Q_Barack_Obama wdt:P31 wd:Q5 ;
    schema:name "Barack Obama"@en .
	
