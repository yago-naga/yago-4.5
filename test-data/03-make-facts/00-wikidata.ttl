	schema:name "organization"@en .

# Geo locations
wd:Q31  wdt:P31	schema:Country ;
	schema:name "Belgium"@en ;
	# Memberof should go to locatedIn
	wdt:P463 wd:Schengen ;
	# Max value bypassed
	wdt:P6897	"lkblblhbl"^^xsd:decimal ;
	wdt:P6897	"500"^^xsd:decimal ;
	# Integers get normalized and cast to integer
	wdt:P3000	"+20.0"^^xsd:decimal ;
	schema:geo      "Point(4.6680555555556 50.641111111111)"^^geo:wktLiteral        .

