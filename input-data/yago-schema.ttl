@prefix geo: <http://www.opengis.net/ont/geosparql> .
@prefix owl: <http://www.w3.org/2002/07/owl> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl> .
@prefix skos: <http://www.w3.org/2004/02/skos/core> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix wpq: <http://www.wikidata.org/prop/qualifier/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema> .
@prefix yago: <http://yago-knowledge.org/resource/> .
@prefix ys: <http://yago-knowledge.org/schema> .

################################################################
#                       Preamble
################################################################

# This is the manually designed schema of YAGO 4.5.1
# CC-BY The YAGO Team
# Do not overwrite this file.
#
# Each class defined here will automatically draw in its subclasses from Wikidata.
# 
# Therefore, classes should be defined here only if
# they have 
# (1) a link to Wikidata and
# (2) properties in which they appear as domain or range 

################################################################
#                Top level classes
################################################################

ys:
	rdfs:label "Manual YAGO 4.5 shapes declaration"@en .

# Disjointness constraints
schema:CreativeWork a rdfs:Class .
schema:Event 
	owl:disjointWith schema:CreativeWork.
schema:Organization owl:disjointWith 
    schema:CreativeWork,
    schema:Event.
schema:Taxon owl:disjointWith 
    schema:CreativeWork,
    schema:Event,
    schema:Organization.
schema:Person owl:disjointWith 
    schema:CreativeWork,
    schema:Event,
    schema:Taxon,
    schema:Organization.
schema:Place owl:disjointWith 
    # schema:CreativeWork, # Fabian: Many places have been created by humans, in particular monuments
    schema:Event,
    schema:Person,
    schema:Taxon. 
schema:Product owl:disjointWith
    schema:Event,
    schema:Organization,
    schema:Taxon,
    schema:Person.
    # schema:Place.	# Fabian 2026-06-17: Greenhouses, rocket launchers, etc.
schema:BioChemEntity owl:disjointWith
    schema:CreativeWork, 
    schema:Event,
    schema:Organization,
    schema:Taxon,
    schema:Person,
    schema:Place.	
schema:Intangible  owl:disjointWith
    schema:Event,
    schema:Organization,
    schema:Taxon,
    schema:BioChemEntity,
    schema:Person,
    schema:Place.	


################################################################
#                Things
################################################################

# Top-level class of all individuals
# (excluding literals, classes, properties, etc.)
	
schema:Thing a sh:NodeShape ;
    # ys:fromClass wd:Q35120 ; No mapping!
	
	# Descriptive properties
	
	sh:property [
        sh:path rdf:type ;
		sh:minCount 1 ;
        sh:class rdfs:Class ; 
        ys:fromProperty wdt:P31, wdt:P106, wdt:P136, wdt:P39, wdt:P166; # From type, occupation, genre, position, award
        rdfs:comment "The class that a Thing belongs to"@en ;
    ] ;	
    sh:property [
        sh:path yago:siteLinks ;
		sh:minInclusive 1 ;
		sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        ys:fromProperty wikibase:sitelinks ;
        rdfs:comment "The number of Wikipedia links to this entity, as a proxy measure for importance"@en ;
    ] ;	
	sh:property [
        sh:path schema:image ;
        sh:datatype xsd:anyURI ;
        ys:fromProperty wdt:P18 ;
        rdfs:comment "An image of the entity"@en ;
    ] ;	
    sh:property [
        sh:path schema:alternateName ;
        sh:datatype rdf:langString ;
        ys:fromProperty skos:altLabel, wdt:P2521, wdt:P225, wdt:P1843, wdt:P1448, wdt:P1559, wdt:P1477, wdt:P2521, wdt:P2562, wdt:P742, wdt:P1449 ;
        rdfs:comment "An alternative name for the entity"@en ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        ys:fromProperty schema:description ;
        rdfs:comment "Provides a comment or description of an entity in a specific language"@en ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
	    sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
		ys:fromProperty schema:name, wdt:P2561, wdt:P1476, wdt:P5061, wdt:P1705 ;
        rdfs:comment "Provides a human-readable label for an entity in a specific language"@en ;
    ] ; 
	sh:property [
        sh:path schema:url ;
        sh:datatype xsd:anyURI ;
        ys:fromProperty wdt:P854, wdt:P856, wdt:P973, wdt:P2699 ; 
        rdfs:comment "A URL associated with the Thing"@en ;
    ] ;	
	# We map to Wikidata, Freebase, Google knowledge graph, WordNet, and IMDB.
    sh:property [
        sh:path schema:sameAs ;
		sh:datatype xsd:string ;
        ys:fromProperty wdt:P646, wdt:P345, wdt:P2671, wdt:P1053, wdt:P8814;
        rdfs:comment "An identifier of the same entity in another knowledge base"@en ;
	] ; 
	
	# Properties that any object can have
	
	sh:property [
        sh:path yago:appearsIn ;
        sh:class schema:CreativeWork ;
        ys:fromProperty wdt:P1080, wdt:P1441, wdt:P4584 ;
        rdfs:comment "A CreativeWork in which a Thing appears"@en ;
    ] ;
    sh:property [
        sh:path yago:namedAfter ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P138 ;
        rdfs:comment "Entity after which this item is named"@en ;
    ] ;
	sh:property [
        sh:path yago:partOf ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P361 ;
        rdfs:comment "A larger Thing that contains this Thing"@en ;
    ] ;
    sh:property [
        sh:path yago:follows ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P155, wdt:P1365 ;
        rdfs:comment "An entity that follows another entity chronologically or conceptually"@en ;
    ] .
	

# Class of all classes. Classes can have properties, too, but only annotation properties.
rdfs:Class a sh:NodeShape ;  
    sh:property [
        sh:path yago:siteLinks ;
		sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        ys:fromProperty wikibase:sitelinks ;
        rdfs:comment "The number of Wikipedia links to this entity, as a proxy measure for importance"@en ;
    ] ;	
	sh:property [
        sh:path schema:image ;
        sh:datatype xsd:anyURI ;
        ys:fromProperty wdt:P18 ;
        rdfs:comment "An image of the entity"@en ;
    ] ;	
	sh:property [
        sh:path schema:alternateName ;
        sh:datatype rdf:langString ;
        ys:fromProperty skos:altLabel ;
        rdfs:comment "An alternative name for the entity"@en ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        ys:fromProperty schema:description ;
        rdfs:comment "Provides a comment or description of an entity in a specific language"@en ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype rdf:langString ;
		sh:minCount 1 ;
        sh:uniqueLang true ;
		ys:fromProperty schema:name, wdt:P2561 ;
        rdfs:comment "Provides a human-readable label for an entity in a specific language"@en ;
    ] ;
    sh:property [
        sh:path schema:sameAs ;
		sh:datatype xsd:string ;
        ys:fromProperty wdt:P646, wdt:P345, wdt:P2671, wdt:P1053, wdt:P8814;
        rdfs:comment "An identifier of the same entity in another knowledge base"@en ;
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:datatype xsd:anyURI ;
		ys:fromProperty wdt:P854, wdt:P856, wdt:P973, wdt:P2699; 
        rdfs:comment "A URL associated with the Thing"@en ;
    ] . 

# Class of all properties. Properties can have only annotation properties.
rdf:Property a sh:NodeShape ;
    ys:fromClass wd:Q18616576 ; 
    sh:property [
        sh:path schema:alternateName ;
        sh:datatype rdf:langString ;
        ys:fromProperty skos:altLabel, schema:alternateName ;
        rdfs:comment "An alternative name for the entity"@en ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        ys:fromProperty schema:description, rdfs:comment ;
        rdfs:comment "Provides a comment or description of an entity in a specific language"@en ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype rdf:langString ;
		sh:minCount 1 ;
        sh:uniqueLang true ;
		ys:fromProperty schema:name, rdfs:label ;
        rdfs:comment "Provides a human-readable label for an entity in a specific language"@en ;
    ] ;
    sh:property [
        sh:path schema:sameAs ;
		sh:datatype xsd:string ;
        ys:fromProperty wdt:P1628, schema:sameAs ;
        rdfs:comment "An identifier of the same entity in another knowledge base"@en ;  
    ] .
    
################################################################
#                Intangibles
################################################################

schema:Intangible a rdfs:Class, sh:NodeShape;
	rdfs:subClassOf schema:Thing ;
	rdfs:label "Intangible entity"@en . 

#Margherita 25/06/2026 added class
yago:AcademicDiscipline a sh:NodeShape ;
    rdfs:subClassOf schema:Intangible ;
    rdfs:label "Academic discipline"@en ;
    rdfs:comment "A field of academic study (e.g., mathematics, philosophy, linguistics)"@en ;
    ys:fromClass wd:Q11862829, wd:Q4671286 .

# Awards are needed as domain of schema:award
yago:Award a sh:NodeShape ;
    ys:fromClass wd:Q618779, wd:Q38033430 ;
    rdfs:subClassOf schema:Intangible ;
    sh:property [
        sh:path schema:sponsor ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P859 ;
    ] ;
    sh:property [
        sh:path yago:conferredBy ; 
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P1027 ;
        rdfs:comment "The organization or person that conferred an award"@en ;
    ] .

# Religions etc. are intangibles
yago:BeliefSystem a sh:NodeShape ;
	rdfs:subClassOf schema:Intangible ;
    ys:fromClass wd:Q5390013, wd:Q49447, wd:Q9174 .
	#; They are classes and cannot have properties
	#sh:property [
    #    sh:path yago:foundationalText ; 
    #    sh:class schema:CreativeWork ;
    #    ys:fromProperty wdt:P547 ;
    #] ;
    #sh:property [
    #    sh:path schema:founder ;
    #    sh:class schema:Person ;
    #    ys:fromProperty wdt:P112 ;
    #] .

# We need genders as objects of yago:gender
yago:Gender a sh:NodeShape ;
    ys:fromClass wd:Q48264 ;
    rdfs:subClassOf schema:Intangible .

yago:Color a sh:NodeShape ;
    ys:fromClass wd:Q1075 ;         
    rdfs:subClassOf schema:Intangible .

yago:HairColor a sh:NodeShape ;
    ys:fromClass wd:Q1048314, wd:Q105825176 ;         
    rdfs:subClassOf yago:Color .

yago:MusicalInstrument a sh:NodeShape ;
    ys:fromClass wd:Q34379, wd:Q1254773 ;
    rdfs:subClassOf schema:Product .

# Needed as range of the property schema:inLanguage
schema:Language a sh:NodeShape ;
	rdfs:subClassOf schema:Intangible ;
    ys:fromClass wd:Q34770, wd:Q17376908 .

# Needed for treatment of person names. Used only internally,
# as names are replaced by strings. Is automatically removed from final taxonomy.
yago:PersonName a sh:NodeShape ;
	rdfs:subClassOf schema:Intangible ;
    ys:fromClass wd:Q10856962 .
	
# For units of measurement for quantified properties such as "width"
yago:UnitOfMeasurement a sh:NodeShape ;
	rdfs:subClassOf schema:Intangible ;
	sh:property [
        sh:path yago:siConversion ;
		sh:maxCount 1;
		sh:datatype yago:UnitOfMeasurement ;
		ys:fromProperty wdt:P2370 ;
	] ;	
    ys:fromClass wd:Q47574 .

yago:UnitOfLuminosity a sh:NodeShape ;
    rdfs:subClassOf yago:UnitOfMeasurement ;
	ys:fromClass wd:Q843877 .
yago:UnitOfLength a sh:NodeShape ;
	rdfs:subClassOf yago:UnitOfMeasurement ;
	ys:fromClass wd:Q1978718 .

yago:UnitOfArea a sh:NodeShape ;
	rdfs:subClassOf yago:UnitOfMeasurement ;
	ys:fromClass wd:Q1371562 .
	
yago:UnitOfTime a sh:NodeShape ;
	rdfs:subClassOf yago:UnitOfMeasurement ;
	ys:fromClass wd:Q1790144 .
	
yago:UnitOfMass a sh:NodeShape ;
	rdfs:subClassOf yago:UnitOfMeasurement ;
	ys:fromClass wd:Q3647172 .
	
yago:UnitOfMoney a sh:NodeShape ;
	rdfs:subClassOf yago:UnitOfMeasurement ;
	ys:fromClass wd:Q8142 .

yago:UnitOfSpeed a sh:NodeShape ;
	rdfs:subClassOf yago:UnitOfMeasurement ;
	ys:fromClass wd:Q15222637 .

yago:UnitOfTemperature a sh:NodeShape ;
	rdfs:subClassOf yago:UnitOfMeasurement ;
	ys:fromClass wd:Q68723978 .
	
################################################################
#                Creative Works
################################################################

schema:CreativeWork a sh:NodeShape ;
    ys:fromClass wd:Q17537576, wd:Q386724 ;
	rdfs:subClassOf schema:Thing ;
	rdfs:label "Creative work"@en ;
    sh:property [
        sh:path schema:editor ;
        sh:class schema:Person ;
        ys:fromProperty wdt:P98 ;
        rdfs:comment "An editor of a Book"@en ;
    ] ;		
	sh:property [
        sh:path yago:creator ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P50, wdt:P170, wdt:P112 ; 
    ] ;
    sh:property [
        sh:path schema:logo ;
        sh:datatype xsd:anyURI ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P154 ;
        rdfs:comment "The logo of an entity"@en ;
    ] ;	
	sh:property [
        sh:path schema:slogan ; 
        sh:datatype rdf:langString ;
        ys:fromProperty wdt:P1451 ;
    ] ;		
	sh:property [
        sh:path schema:startDate ;
        sh:or (
            [
                sh:datatype xsd:dateTime
            ]
            [
                sh:datatype xsd:date
            ]
            [
                sh:datatype xsd:gYearMonth
            ]
            [
                sh:datatype xsd:gYear
            ]
        ) ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P571, wdt:P580  ;
        rdfs:comment "The date an entity started existing"@en ;
    ] ;
	sh:property [
        sh:path schema:endDate ;
        sh:or (
            [
                sh:datatype xsd:dateTime
            ]
            [
                sh:datatype xsd:date
            ]
            [
                sh:datatype xsd:gYearMonth
            ]
            [
                sh:datatype xsd:gYear
            ]
        ) ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P576, wdt:P582 ;
        rdfs:comment "The date when an entity stopped existing"@en ;
    ] ;
    sh:property [
        sh:path yago:ownedBy ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P127 ;
        rdfs:comment "The Organization or Person that owns an entity"@en ;
    ] ;
    sh:property [
        sh:path yago:influencedBy ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P737, wdt:P941 ;
        rdfs:comment "An entity that influenced the entity"@en ;
    ] ;
    sh:property [
        sh:path yago:hasCause ;
        ys:fromProperty wdt:P828 ;
        sh:class schema:Thing ;
    ] ;
    sh:property [
        sh:path schema:award ;
        sh:class yago:Award ;
        ys:fromProperty wdt:P166 ;
        rdfs:comment "An award won by an entity"@en ;
    ] ;	
    sh:property [
        sh:path schema:sponsor ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
   	ys:fromProperty wdt:P859 ;
        rdfs:comment "The sponsor of an entity"@en ;
    ] ;
	sh:property [
        sh:path schema:color ;
        ys:fromProperty wdt:P462 ;  
        sh:class yago:Color ;       
        rdfs:comment "The color of an entity"@en ;
    ] ;	
	sh:property [
        sh:path schema:width ;
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2049 ;
		sh:maxCount 1 ;
        rdfs:comment "The width of an object"@en ;
    ] ;
    sh:property [
        sh:path schema:height ;
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2048 ;
		sh:maxCount 1 ;
        rdfs:comment "The height of an object"@en ;
    ] ;
    sh:property [
        sh:path yago:length ;
        sh:datatype yago:UnitOfLength ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P2043 ;
        rdfs:comment "The length of an object"@en ;
    ] ;
	sh:property [
        sh:path yago:mass ;
		sh:maxCount 1 ;
        sh:datatype yago:UnitOfMass ;
        ys:fromProperty wdt:P2067 ;
        rdfs:comment "The mass of an entity"@en ;
    ] ;	
    sh:property [
        sh:path schema:material ;
        sh:class schema:BioChemEntity ;
        ys:fromProperty wdt:P186 ;
        rdfs:comment "The material of a Thing"@en ;
    ] ;
    sh:property [
        sh:path schema:price ;
        sh:datatype yago:UnitOfMoney ;
        ys:fromProperty wdt:P2284 ;
    ] ;
    sh:property [
        sh:path schema:publisher ;
		sh:maxCount 1 ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P123 ;
        rdfs:comment "The publisher of a Book or Newspaper"@en ;
    ] ;	
	sh:property [
        sh:path schema:about ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P921 ;
        rdfs:comment "Indicates what an entity (e.g., CreativeWork or Event) is about"@en ;
    ] ;
    sh:property [
        sh:path schema:location ;
        sh:or (
		   [ sh:class schema:Place ] 
		   [ sh:class schema:Organization ]
		) ;
		# Fabian: wdt:P361 is overloaded with partOf, to make countries part of continents etc.
		# Fabian: wdt:P463 is overloaded with memberOf
        ys:fromProperty wdt:P131 , wdt:P276 , wdt:P706 , wdt:P4552, wdt:P17, wdt:P30, wdt:P551, wdt:P361, wdt:P463, wdt:P183, wdt:P9714 ;
        rdfs:comment "The location of an entity"@en ;
    ]  ;   
    sh:property [
        sh:path schema:locationCreated ;
        sh:class schema:Place ;
        ys:fromProperty wdt:P495 ;
        rdfs:comment "The location where an entity was created"@en ;
    ] ;	
    sh:property [
        sh:path schema:contentLocation ;
        sh:or ([sh:class schema:Place] [sh:class schema:Organization ]) ;
        ys:fromProperty wdt:P840 ;
        rdfs:comment "The location depicted or described in the CreativeWork"@en ;
    ] ;
    sh:property [
        sh:path schema:requiredMinAge ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2899 ;
        rdfs:comment "Minimum required age in years"@en ;
    ] ;
    sh:property [
        sh:path schema:requiredMaxAge ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P4135 ;
        rdfs:comment "Maximum required age in years"@en ;
    ] ;
    sh:property [
        sh:path yago:artDirector ;
        sh:class schema:Person ;
        ys:fromProperty wdt:P3174 ;
        rdfs:comment "Person credited as the art director of this Creative Work"@en ;
    ] ;
    sh:property [
        sh:path schema:performer ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
	ys:fromProperty wdt:P175, wdt:P161  ;
        rdfs:comment "An Agent who performs in this Creative Work"@en ;
    ] ;
    sh:property [
        sh:path yago:publishedOn ;
        sh:class schema:Organization ;
        ys:fromProperty wdt:P449 ;
        rdfs:comment "Original broadcaster of a creative work"@en ;
    ] ;
    sh:property [
        sh:path schema:duration ;
		sh:maxCount 1 ;
        sh:datatype yago:UnitOfTime ;
        ys:fromProperty wdt:P2047 ;
        rdfs:comment "The duration of a CreativeWork (movie, song, etc.)"@en ;
    ] ;
    sh:property [
        sh:path schema:manufacturer ;
        sh:class schema:Organization ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P176 ;
        rdfs:comment "The manufacturer of a CreativeWork or Product"@en ;
    ] ;
    sh:property [
        sh:path schema:director ;
        sh:class schema:Person ;
        ys:fromProperty wdt:P57 ;
        rdfs:comment "The director of a CreativeWork"@en ;
    ] ;	
    sh:property [
        sh:path schema:illustrator ;
        sh:class schema:Person ;
        ys:fromProperty wdt:P110 ;
        rdfs:comment "The illustrator of a CreativeWork"@en ;
    ] ;
    sh:property [
        sh:path schema:inLanguage ;
        sh:class schema:Language ;
        ys:fromProperty wdt:P364, wdt:P407 ;
        rdfs:comment "The language of an entity (e.g., CreativeWork)"@en ;
    ] ;
	sh:property [
        sh:path schema:productionCompany ;
        sh:class schema:Organization ;
        ys:fromProperty wdt:P272 ;
        rdfs:comment "The production company for a Movie or TV Series"@en ;
    ] ;
    sh:property [
        sh:path schema:musicBy ; 
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P86 ;
        rdfs:comment "The composer or musician for a Movie, TV Series, or MusicComposition"@en ;
    ] ;		
    sh:property [
        sh:path yago:directorOfPhotography ;
        sh:class schema:Person ;
        ys:fromProperty wdt:P344 ;
        rdfs:comment "The director of photography for a Movie or TV Series"@en ;
    ] ;
    sh:property [
        sh:path schema:gtin ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{12,14}|\\d{8}$" ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P3962 
    ] .
 
schema:Book a sh:NodeShape ;
    rdfs:subClassOf schema:CreativeWork ;
    ys:fromClass wd:Q571, wd:Q3331189, wd:Q7725634, wd:Q1004 ;
    sh:property [
        sh:path schema:numberOfPages ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P1104 ;
        rdfs:comment "The number of pages in a Book"@en ;
    ]  ;  
    sh:property [
        sh:path schema:isbn ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P212 , wdt:P957 ;
        sh:pattern "^(97[89]-([0-57]-(\\d-\\d{7}|\\d\\d-\\d{6}|\\d\\d\\d-\\d{5}|\\d{4}-\\d{4}|\\d{5}-\\d\\d\\d|\\d{6}-\\d\\d|\\d{7}-\\d)|[89]\\d-(\\d-\\d{6}|\\d\\d-\\d{5}|\\d\\d\\d-\\d{4}|\\d{4}-\\d\\d\\d|\\d{5}-\\d\\d|\\d{6}-\\d)|[69]\\d\\d-(\\d-\\d{5}|\\d\\d-\\d{4}|\\d\\d\\d-\\d\\d\\d|\\d{4}-\\d\\d|\\d{5}-\\d)|99[0-8]\\d-\\d-\\d{4}|99[0-8]\\d-\\d\\d-\\d\\d\\d|99[0-8]\\d-\\d\\d\\d-\\d\\d|99[0-8]\\d-\\d{4}-\\d|999\\d\\d-\\d-\\d\\d\\d|999\\d\\d-\\d\\d-\\d\\d|999\\d\\d-\\d\\d\\d-\\d)-\\d|\\d{9}(\\d|X))|(\\d{1,5}-\\d{1,7}-\\d{1,6}-[0-9X])$" ;
        rdfs:comment "The ISBN (International Standard Book Number) of a Book"@en ;
    ]  .

schema:TVSeries a sh:NodeShape ; 
	rdfs:subClassOf schema:CreativeWork ; # instead of series
	ys:fromClass wd:Q5398426, wd:Q15416 ;
    sh:property [
        sh:path schema:numberOfEpisodes ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P1113 ;
        rdfs:comment "The number of episodes in a TV Series"@en ;
    ] ;
    sh:property [
        sh:path schema:numberOfSeasons ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P2437 ;
        rdfs:comment "The number of seasons in a TV Series"@en ;
    ] .
schema:MusicComposition a sh:NodeShape ;
	rdfs:subClassOf schema:CreativeWork ;
    ys:fromClass wd:Q207628, wd:Q2188189 ;
    sh:property [
        sh:path yago:iswcCode ; # Fabian: Changed from schema: to yago: 2024-04-03
        sh:datatype xsd:string ;
        sh:pattern "^T-[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]$" ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P1827 ;
    ] ;
    sh:property [
        sh:path schema:lyricist ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P676 ;
        rdfs:comment "The lyricist of a MusicComposition"@en ;
    ] .

################################################################
#                Fictional Entities
################################################################

# Fictional entities are Things,
# from  fictional entity (Q14897293) ,  imaginary character (Q115537581) ,  hypothetical entity (Q18706315) ,
#  character that may or may not be fictional (Q21070598),  fictional creature (Q2593744) ,
#  fictional character (Q95074),  non-existent entity (Q64728693),  fictional object (Q15706911)  
yago:FictionalEntity a sh:NodeShape ;
	rdfs:subClassOf schema:Thing ;
	rdfs:label "Fictional entity"@en ;
    sh:property [
        sh:path schema:performer ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P175  ;
        rdfs:comment "An Agent who performs in this Creative Work"@en ;
    ] ;
	sh:property [
        sh:path yago:creator ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P50, wdt:P170, wdt:P112 ; 
    ] ;
    sh:property [
        sh:path schema:gender ;
        sh:class yago:Gender ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P21 ;
    ] ;
  sh:property [
        sh:path schema:spouse ;
        sh:or (
            [ sh:class schema:Person ]
            [ sh:class yago:FictionalEntity ]
        ) ;
        ys:fromProperty wdt:P26 ;
        rdfs:comment "The spouse of a Person"@en ;
    ] ;
    sh:property [
        sh:path yago:partner ;
        sh:or (
            [ sh:class schema:Person ]
            [ sh:class yago:FictionalEntity ]
        ) ;
        ys:fromProperty wdt:P451 ;
        rdfs:comment "The unmarried partner of a Person"@en ;
    ] ;   
    sh:property [
        sh:path schema:knowsLanguage ;
        sh:class schema:Language ;
        ys:fromProperty wdt:P1412 ;
    ] ;
    sh:property [
        sh:path yago:beliefSystem ;
        sh:class yago:BeliefSystem ; 
        ys:fromProperty wdt:P140, wdt:P1142 ;
    ] ; 
	sh:property [
        sh:path schema:address ;
        sh:datatype xsd:string ;
        ys:fromProperty wdt:P6375 ;
    ] ;
	sh:property [
        sh:path schema:location ;
        sh:or ([sh:class schema:Place] [sh:class schema:Organization ]) ;
		# Fabian: wdt:P361 is overloaded with partOf, to make countries part of continents etc.
		# Fabian: wdt:P463 is overloaded with memberOf
        ys:fromProperty wdt:P131 , wdt:P276 , wdt:P706 , wdt:P4552, wdt:P17, wdt:P30, wdt:P551, wdt:P361, wdt:P463, wdt:P183, wdt:P9714 ;
    ]  ;   
    sh:property [
        sh:path schema:locationCreated ;
        sh:class schema:Place ;
        ys:fromProperty wdt:P495 ;
    ] ;	
	sh:property [
        sh:path schema:color ;
        ys:fromProperty wdt:P462 ;  
        sh:class yago:Color ;       
    ] ;	
	sh:property [
        sh:path schema:width ;
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2049 ;
		sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path schema:height ;
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2048 ;
		sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path yago:length ;
        sh:datatype yago:UnitOfLength ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P2043 ;
    ] ;
	sh:property [
        sh:path yago:mass ;
		sh:maxCount 1 ;
        sh:datatype yago:UnitOfMass ;
        ys:fromProperty wdt:P2067 ;
    ] ;	
    sh:property [
        sh:path schema:material ;
        sh:class schema:BioChemEntity ;
        ys:fromProperty wdt:P186 ;
    ] ;
	ys:fromClass wd:Q14897293, wd:Q115537581, wd:Q18706315, wd:Q21070598, wd:Q64728693 .

################################################################
#                Events
################################################################

schema:Event a sh:NodeShape ;
    # Remove "occurrence", is a bad class
    ys:fromClass wd:Q1656682, wd:Q132821, wd:Q11514315, wd:Q350604 ;
	rdfs:label "Event"@en ;
    rdfs:subClassOf schema:Thing ;
	sh:property [
        sh:path yago:creator ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P50, wdt:P170, wdt:P112 ; 
    ] ;
	sh:property [
        sh:path schema:slogan ; # Fabian: changed from motto to slogan 2024-04-03
        sh:datatype rdf:langString ;
        ys:fromProperty wdt:P1451 ;
    ] ;		
	sh:property [
        sh:path schema:address ;
        sh:datatype xsd:string ;
        ys:fromProperty wdt:P6375 ;
    ] ;
	sh:property [
        sh:path schema:location ;
        sh:or ([sh:class schema:Place] [sh:class schema:Organization ]) ;
		# Fabian: wdt:P361 is overloaded with partOf, to make countries part of continents etc.
		# Fabian: wdt:P463 is overloaded with memberOf
        ys:fromProperty wdt:P131 , wdt:P276 , wdt:P706 , wdt:P4552, wdt:P17, wdt:P30, wdt:P551, wdt:P361, wdt:P463, wdt:P183, wdt:P9714 ;
    ]  ;  
    sh:property [
        sh:path schema:locationCreated ;
        sh:class schema:Place ;
        ys:fromProperty wdt:P495 ;
    ] ;	 
	sh:property [
        sh:path schema:startDate ;
        sh:or (
            [
                sh:datatype xsd:dateTime
            ]
            [
                sh:datatype xsd:date
            ]
            [
                sh:datatype xsd:gYearMonth
            ]
            [
                sh:datatype xsd:gYear
            ]
        ) ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P571, wdt:P580  ;
    ] ;
	sh:property [
        sh:path schema:endDate ;
        sh:or (
            [
                sh:datatype xsd:dateTime
            ]
            [
                sh:datatype xsd:date
            ]
            [
                sh:datatype xsd:gYearMonth
            ]
            [
                sh:datatype xsd:gYear
            ]
        ) ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P576, wdt:P582 ;
    ] ;
    sh:property [
        sh:path schema:about ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P921 ;
    ] ;
   sh:property [
        sh:path yago:beliefSystem ;
        sh:class yago:BeliefSystem ; 
        ys:fromProperty wdt:P140, wdt:P1142 ;
    ] ; 
   sh:property [
        sh:path yago:ownedBy ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P127 ;
    ] ;
    sh:property [
        sh:path yago:influencedBy ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P737, wdt:P941 ;
    ] ;
    sh:property [
        sh:path schema:sponsor ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P859 ;
    ] ;
    sh:property [
        sh:path schema:logo ;
        sh:datatype xsd:anyURI ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P154 ;
    ] ;	
    sh:property [
        sh:path schema:inLanguage ;
        sh:class schema:Language ;
        ys:fromProperty wdt:P364, wdt:P407 ;
    ] ;	
    sh:property [
        sh:path schema:organizer ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P664 ;
        rdfs:comment "The organizer of an Event"@en ;
    ] ;
    sh:property [
        sh:path yago:leader ; 
        sh:class schema:Person ;
        ys:fromProperty wdt:P35, wdt:P6, wdt:P168, wdt:P169, wdt:P1075, wdt:P1037, wdt:P1875;
    ] ;
    sh:property [
        sh:path yago:winner ;
        ys:fromProperty wdt:P1346 ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        rdfs:comment "Winner of the event"@en ;
    ] ;
   sh:property [
        sh:path schema:performer ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P175  ;
        rdfs:comment "An Agent who performs in this Creative Work"@en ;
    ] ;
  sh:property [
        sh:path yago:officialLanguage ; 
        sh:class schema:Language ;
        ys:fromProperty wdt:P37 ;
    ] ;	
  sh:property [
        sh:path yago:publishedOn ;
        sh:class schema:Organization ;
        ys:fromProperty wdt:P449 ;
    ] ;
   sh:property [
        sh:path yago:deathNumber ;
        sh:datatype xsd:integer ;
        ys:fromProperty wdt:P1120  ;
        rdfs:comment "Number of people who died due to this event"@en ;
    ] ;
    sh:property [
        sh:path yago:participant ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P710, wdt:P1923 ;
        rdfs:comment "A Person or Organization that participated in an Event"@en ;
    ] ;
    sh:property [
        sh:path schema:requiredMinAge ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2899 ;
    ] ;
    sh:property [
        sh:path schema:requiredMaxAge ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P4135 ;
        rdfs:comment "Maximum required age in years"@en ;
    ] ;
    sh:property [
        sh:path yago:hasCause ;
        ys:fromProperty wdt:P828 ;
        sh:class schema:Thing ;
        rdfs:comment "The cause of an Event"@en ;
    ] ;
    sh:property [
        sh:path yago:artDirector ;
        sh:class schema:Person ;
        ys:fromProperty wdt:P3174 ;
        rdfs:comment "Person credited as the art director of this Creative Work"@en ;
    ] ;
    sh:property [
        sh:path schema:maximumAttendeeCapacity ;
        sh:datatype xsd:integer ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P1083 ;
	    rdfs:comment "The total number of individuals that may attend an event or venue"@en ;	
    ] .

# Fabian 2023-05-04: In Wikidata, elections are subclasses of two disjoint classes, so we attach it under Event here
yago:Election a sh:NodeShape ;
	rdfs:subClassOf schema:Event ;
    ys:fromClass wd:Q40231 .


################################################################
#                Organizations
################################################################

schema:Organization a sh:NodeShape ; 
    rdfs:subClassOf schema:Thing; 
    rdfs:label "Organization"@en ;
    ys:fromClass wd:Q43229, wd:Q895526, wd:Q167037, wd:Q155076 ; # Fabian: we add corporations here (in the sense of legal entities), and juridical persons, and organs
    sh:property [
        sh:path yago:beliefSystem ;
        sh:class yago:BeliefSystem ; 
        ys:fromProperty wdt:P140, wdt:P1142 ;
        rdfs:comment "The belief system (e.g., religion) of an entity"@en ;
    ] ; 
    sh:property [
        sh:path yago:interestedIn ; 
        sh:class schema:Thing ; 
        ys:fromProperty wdt:P2650;
        rdfs:comment "The field of interest of the entity"@en ;
    ] ;  
    sh:property [
        sh:path yago:influencedBy ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P737, wdt:P941 ;
    ] ;
    sh:property [
        sh:path schema:award ;
        sh:class yago:Award ;
        ys:fromProperty wdt:P166 ;
    ] ;	
    sh:property [
        sh:path schema:sponsor ;
        sh:class schema:Organization ;
        ys:fromProperty wdt:P859 ;
    ] ;
    sh:property [
        sh:path schema:memberOf ;
        sh:class schema:Organization ;
        ys:fromProperty wdt:P463, wdt:P114 ;
        rdfs:comment "An Organization that a Person or another Organization is a member of"@en ;
    ] ;
    sh:property [
        sh:path yago:fieldOfWork ;
        sh:class schema:Thing ; 
        ys:fromProperty wdt:P101 ;
        rdfs:comment "The field of work of the Agent"@en ;
    ] ;
    sh:property [
        sh:path schema:slogan ; 
        sh:datatype rdf:langString ;
        ys:fromProperty wdt:P1451 ;
    ] ;	
    sh:property [
        sh:path schema:address ;
        sh:datatype xsd:string ;
        ys:fromProperty wdt:P6375 ;
    ] ;
    sh:property [
        sh:path schema:postalCode ;
        sh:datatype xsd:string ;
        ys:fromProperty wdt:P281 ;
    ] ;
    sh:property [
        sh:path schema:geo ;
        sh:datatype geo:wktLiteral ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P625 ;
    ] ;
   sh:property [
        sh:path schema:location ;
        sh:class schema:Place ;
		# Fabian: wdt:P361 is overloaded with partOf, to make countries part of continents etc.
		# Fabian: wdt:P463 is overloaded with memberOf
        ys:fromProperty wdt:P131 , wdt:P276 , wdt:P706 , wdt:P4552, wdt:P17, wdt:P30, wdt:P551, wdt:P361, wdt:P463, wdt:P183, wdt:P9714 ;
    ]  ;   
    sh:property [ 
        sh:path yago:playsIn ;
        sh:or (
            [
                sh:class schema:Organization
            ]
            [
                sh:class schema:Event
            ]
        ) ;
		ys:fromProperty wdt:P118 ;
        rdfs:comment "An Event in which an Agent plays"@en ;
    ] ;
    sh:property [
        sh:path yago:officialLanguage ; # Fabian: changed from schema:... 2024-04-03
        sh:class schema:Language ;
        ys:fromProperty wdt:P37 ;
        rdfs:comment "An official Language of an entity"@en ;
    ] ;	
    sh:property [
        sh:path schema:logo ;
        sh:datatype xsd:anyURI ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P154 ;
    ] ;
    sh:property [
        sh:path yago:currency ;
        ys:fromProperty wdt:P38 ;
        sh:class yago:UnitOfMoney ;
        rdfs:comment "Official currency of the organization"@en ;
    ] ;	
    sh:property [
        sh:path schema:duns ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{9}$" ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P2771 ;
        rdfs:comment "The Dun & Bradstreet DUNS number for identifying an Organization"@en ;
    ] ;
    sh:property [
        sh:path yago:leader ; # Fabian: changed from schema: to yago: 2024-04-03
        sh:class schema:Person ;
        ys:fromProperty wdt:P35, wdt:P6, wdt:P168, wdt:P169, wdt:P1075, wdt:P1037, wdt:P1875;
        rdfs:comment "The leader of an Organization or AdministrativeArea"@en ;
    ] ;
    sh:property [
        sh:path yago:creator ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P50, wdt:P170, wdt:P112 ; 
    ] ;
    sh:property [
        sh:path yago:ownedBy ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P127 ;
    ] ;
    sh:property [
        sh:path schema:leiCode ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9A-Z]{18}[0-9]{2}$" ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P1278 ;
        rdfs:comment "The Legal Entity Identifier (LEI) code for an Organization"@en ;
    ] ;
    sh:property [
        sh:path schema:requiredMinAge ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2899 ;
    ] ;
    sh:property [
        sh:path schema:requiredMaxAge ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P4135 ;
    ] ;
    sh:property [
        sh:path schema:startDate ;
        sh:or (
            [
                sh:datatype xsd:dateTime
            ]
            [
                sh:datatype xsd:date
            ]
            [
                sh:datatype xsd:gYearMonth
            ]
            [
                sh:datatype xsd:gYear
            ]
        ) ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P571, wdt:P580  ;
    ] ;
	sh:property [
        sh:path schema:endDate ;
        sh:or (
            [
                sh:datatype xsd:dateTime
            ]
            [
                sh:datatype xsd:date
            ]
            [
                sh:datatype xsd:gYearMonth
            ]
            [
                sh:datatype xsd:gYear
            ]
        ) ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P576, wdt:P582 ;
    ] ;
    sh:property [
        sh:path schema:about ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P921 ;
    ] ;
    sh:property [
        sh:path yago:medicalSpecialty ;
        sh:or (
            [ sh:class schema:MedicalSpecialty ]
            [ sh:class yago:AcademicDiscipline ]
	) ;
        ys:fromProperty wdt:P1995 ;
    ] ;
    sh:property [
        sh:path schema:locationCreated ;
        sh:class schema:Place ;
        ys:fromProperty wdt:P495 ;
    ] ;
    sh:property [
        sh:path yago:floruit ;
        sh:or (
            [ sh:datatype xsd:dateTime ]
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:gYearMonth ]
            [ sh:datatype xsd:gYear ]
        ) ;
        ys:fromProperty wdt:P1317 ;
    ] ;
    sh:property [
        sh:path yago:notableWork ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P800 ;
    ] ;		
    sh:property [
        sh:path schema:numberOfEmployees ;
        sh:datatype xsd:integer ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P1128 ;
        rdfs:comment "The number of employees in an Organization"@en ;
    ]  .

schema:Corporation a sh:NodeShape ;
     rdfs:subClassOf schema:Organization ;
     ys:fromClass wd:Q783794 ; # Fabian 2023-05-04: we merge companies 
	ys:fromClass wd:Q4830453  # Fabian 2023-03-29: we merge in businesses here
.

schema:Airline a sh:NodeShape ;
    ys:fromClass wd:Q46970, wd:Q62447 ;
	rdfs:subClassOf schema:Corporation ;
    sh:property [
        sh:path schema:iataCode ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z0-9]{2,3}$" ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P229 ;
        rdfs:comment "The IATA code for an Airport or Airline"@en ; 
    ] ;
    sh:property [
        sh:path schema:icaoCode ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z]{3}$" ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P230 ;
        rdfs:comment "The ICAO code for an Airport or Airline"@en ;
    ] .


# We attach it under organization, to avoid CivicStructure
schema:EducationalOrganization a sh:NodeShape ;
	rdfs:subClassOf schema:Organization ;
    ys:fromClass wd:Q5341295 ;
    sh:property [
        sh:path yago:studentsCount ;
        sh:datatype xsd:integer ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2196 ;
        rdfs:comment "The number of students in an EducationalOrganization"@en ;
    ] .

# We need this as a superclass of MusicGroup
schema:PerformingGroup rdf:type sh:NodeShape ;
    rdfs:subClassOf schema:Organization ; 
    sh:property [
        sh:path schema:knowsLanguage ;
        sh:class schema:Language ;
        ys:fromProperty wdt:P1412 ;
        rdfs:comment "A language known by a Person or PerformingGroup"@en ;
    ] ;
    ys:fromClass wd:Q105815710 .

################################################################
#                Persons
################################################################

schema:Person a sh:NodeShape ;
    rdfs:subClassOf schema:Thing ;
    rdfs:label "Person"@en ;
    ys:fromClass wd:Q5, wd:Q215627, wd:Q212238 ; # Fabian: adding "civil servant" here to fix a bug in Wikidata that makes civil servants organizations
    sh:property [   # Fabian: Vivaldi was a student as well 2025-12-09 :-)
    	sh:path yago:studentOf ;
    	sh:class schema:Person ;
    	ys:fromProperty wdt:P1066 ;
        rdfs:comment "A Person who was a student of an Academic"@en ;
	] ;		
   sh:property [
        sh:path yago:hairColor ;
		sh:maxCount 1 ;
        sh:datatype yago:HairColor ;
        ys:fromProperty wdt:P1884 ;
        rdfs:comment "The hair color of a a person"@en ;
    ] ;
    sh:property [
        sh:path yago:eyeColor ;
		sh:maxCount 1 ;
        sh:datatype yago:Color ;
        ys:fromProperty wdt:P1340 ;
    ] ;
    sh:property [
        sh:path schema:height ;
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2048 ;
		sh:maxCount 1 ;
    ] ;
	sh:property [
        sh:path yago:mass ;
		sh:maxCount 1 ;
        sh:datatype yago:UnitOfMass ;
        ys:fromProperty wdt:P2067 ;
    ] ;	
    sh:property [
        sh:path schema:givenName ;
        sh:datatype xsd:string ;
        ys:fromProperty wdt:P735 ;
        rdfs:comment "First name or another given name of this person"@en ;
    ] ;
    sh:property [
        sh:path schema:familyName ;
        sh:datatype xsd:string ; 
		sh:maxCount 1 ;
        ys:fromProperty wdt:P734 ;
        rdfs:comment "Family name of this person"@en ;
    ] ;
    sh:property [
        sh:path yago:academicDegree ;
        sh:class yago:Award ;
        ys:fromProperty wdt:P512 ;
        rdfs:comment "An academic degree (Award) held by a Person"@en ;
    ] ;
    sh:property [ 
        sh:path schema:worksFor ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P108 ;
        rdfs:comment "An organization, person or place (e.g., theater) that a Person works for"@en ;
    ] ;
    sh:property [
        sh:path schema:instrument ;
        sh:class yago:MusicalInstrument ;
        ys:fromProperty wdt:P1303 ;
        rdfs:comment "Musical instrument played by the Person"@en ;
    ] ;
    sh:property [
        sh:path schema:alumniOf ;
        sh:class schema:Organization ; 
        ys:fromProperty wdt:P69 ;
        rdfs:comment "An Organization that a Person is an alumnus of (typically an educational institution)"@en ;
    ] ;
    sh:property [
        sh:path schema:birthDate ;
        sh:or (
            [
                sh:datatype xsd:dateTime
            ]
            [
                sh:datatype xsd:date
            ]
            [
                sh:datatype xsd:gYearMonth
            ]
            [
                sh:datatype xsd:gYear
            ]
        ) ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P569 ;
        rdfs:comment "The date of birth of a Person"@en ;
    ] ;
    sh:property [
        sh:path schema:birthPlace ;
        sh:class schema:Place ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P19 ;
        rdfs:comment "The place where a Person was born"@en ;
    ] ;
    sh:property [
        sh:path yago:hasMother ;
		sh:maxCount 2 ;
        sh:class schema:Person ;
        ys:fromProperty wdt:P25 ; 
        rdfs:comment "A mother of the Person"@en ; 
    ] ;
    sh:property [
        sh:path yago:hasFather ;
		sh:maxCount 2 ;
        sh:class schema:Person ; 
        ys:fromProperty wdt:P22 ;
        rdfs:comment "A father of the Person"@en ; 
    ] ;
    sh:property [
        sh:path schema:deathDate ;
        sh:or (
            [
                sh:datatype xsd:dateTime
            ]
            [
                sh:datatype xsd:date
            ]
            [
                sh:datatype xsd:gYearMonth
            ]
            [
                sh:datatype xsd:gYear
            ]
        ) ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P570 ;
        rdfs:comment "The date of death of a Person"@en ;
    ] ;
    sh:property [
        sh:path schema:deathPlace ;
        sh:class schema:Place ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P20 ;
        rdfs:comment "The place where a Person died"@en ;
    ] ;
    sh:property [
        sh:path yago:burialPlace ;
	    sh:class schema:Place ;	
        sh:maxCount 1 ;
        ys:fromProperty wdt:P119 ;
        rdfs:comment "The place where a Person is buried"@en ;
    ] ;
    sh:property [
        sh:path yago:deathCause ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P509, wdt:P1196, wdt:P157 ;
        rdfs:comment "Cause of death"@en ;
    ] ;
    sh:property [
        sh:path yago:floruit ;
        sh:or (
            [ sh:datatype xsd:dateTime ]
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:gYearMonth ]
            [ sh:datatype xsd:gYear ]
        ) ;
        ys:fromProperty wdt:P1317 ;
        rdfs:comment "Date when the person was known to be active"@en ;
    ] ;
	sh:property [
        sh:path yago:doctoralAdvisor ;
        sh:class schema:Person ;
        ys:fromProperty wdt:P184 ;
        rdfs:comment "The doctoral advisor of an Academic"@en ;
    ] ;
    sh:property [
        sh:path schema:gender ;
        sh:class yago:Gender ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P21 ;
        rdfs:comment "The gender of a Person"@en ;
    ] ;
    sh:property [
        sh:path schema:knowsLanguage ;
        sh:class schema:Language ;
        ys:fromProperty wdt:P1412 ;
        rdfs:comment "A language known by a Person or PerformingGroup"@en ;
    ] ;
    sh:property [
        sh:path yago:nativeLanguage ;
        sh:class schema:Language ;
        ys:fromProperty wdt:P103 ;
        rdfs:comment "Native language of a Person"@en ;
    ] ;
    sh:property [
        sh:path schema:nationality ;
        sh:class schema:Country ;
        ys:fromProperty wdt:P27 ;
        rdfs:comment "The nationality of a Person (links to a Country)"@en ;
    ] ;	    
    sh:property [
        sh:path schema:spouse ;
        sh:class schema:Person ;
		ys:fromProperty wdt:P26 ;
        rdfs:comment "The spouse of a Person"@en ;
    ] ;
    sh:property [
        sh:path yago:notableWork ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P800 ;
        rdfs:comment "A notable creation by a Person"@en ;
    ] ;		
    sh:property [
        sh:path yago:partner ;
        sh:class schema:Person ;
        ys:fromProperty wdt:P451 ;
        rdfs:comment "The unmarried partner of a Person"@en ;
    ] ;   
    sh:property [
        sh:path yago:beliefSystem ;
        sh:class yago:BeliefSystem ; 
        ys:fromProperty wdt:P140, wdt:P1142 ;
    ] ; 
    sh:property [
        sh:path yago:interestedIn ; 
        sh:class schema:Thing ; 
        ys:fromProperty wdt:P2650;
    ] ;  
    sh:property [
        sh:path yago:influencedBy ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P737, wdt:P941 ;
    ] ;
    sh:property [
        sh:path schema:award ;
        sh:class yago:Award ;
        ys:fromProperty wdt:P166 ;
    ] ;	
    sh:property [
        sh:path schema:sponsor ;
        sh:class schema:Organization ;
        ys:fromProperty wdt:P859 ;
    ] ;
    sh:property [
        sh:path schema:memberOf ;
        sh:class schema:Organization ;
        ys:fromProperty wdt:P463, wdt:P114 ;
    ] ;
    sh:property [
        sh:path yago:fieldOfWork ;
        sh:class schema:Thing ; 
        ys:fromProperty wdt:P101 ;
        rdfs:comment "The field of work of the Agent"@en ;
    ] ;
    sh:property [
        sh:path yago:medicalSpecialty ;
        sh:or (
            [ sh:class schema:MedicalSpecialty ]
            [ sh:class yago:AcademicDiscipline ]
	) ;
        ys:fromProperty wdt:P1995 ;
    ] ;
    sh:property [ 
        sh:path yago:playsIn ;
        sh:or (
            [
                sh:class schema:Organization
            ]
            [
                sh:class schema:Event
            ]
        ) ;
	ys:fromProperty wdt:P118 ;
        rdfs:comment "An Event in which an Agent plays"@en ;
    ] ;
    sh:property [
        sh:path yago:candidateIn ;
        sh:class yago:Election ;
        ys:fromProperty wdt:P3602 ;
        rdfs:comment "An Election that a Politician was a candidate in"@en ;
	] ;
    sh:property [
    	sh:path yago:sportNumber ;
    	sh:datatype xsd:string ;
    	ys:fromProperty wdt:P1618 ;
        rdfs:comment "The sport number (jersey number) of a SportsPerson"@en ;
	] .    

# Thomas: Move property up
# yago:SportsPerson a sh:NodeShape ;
#    ys:fromClass wd:Q50995749 ;	
#	rdfs:subClassOf schema:Person ;
# .

# Thomas: Move property up
# yago:Politician a sh:NodeShape ;
#    ys:fromClass wd:Q82955 ;	
#	rdfs:subClassOf schema:Person ;
#    ] .
	
################################################################
#                Places
################################################################


# General superclass for geographic places
# We don't map this to Wikidata, because we want to control the types of places we have in YAGO

schema:Place a sh:NodeShape ;
    # No mapping here, to avoid getting messy subclasses
    # ys:fromClass wd:Q17334923 ; 
	# Fabian 2026-02-21: Added from Wikidata class region
	ys:fromClass wd:Q82794 ;
	rdfs:subClassOf schema:Thing ;
	rdfs:label "Place"@en ;
    sh:property [
        sh:path schema:geo ;
        sh:datatype geo:wktLiteral ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P625 ;
        rdfs:comment "The geographic coordinates of a Place (in WKT literal format)"@en ;
    ] ;
	sh:property [
        sh:path schema:startDate ;
        sh:or (
            [
                sh:datatype xsd:dateTime
            ]
            [
                sh:datatype xsd:date
            ]
            [
                sh:datatype xsd:gYearMonth
            ]
            [
                sh:datatype xsd:gYear
            ]
        ) ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P571, wdt:P580  ;
    ] ;
	sh:property [
        sh:path schema:endDate ;
        sh:or (
            [
                sh:datatype xsd:dateTime
            ]
            [
                sh:datatype xsd:date
            ]
            [
                sh:datatype xsd:gYearMonth
            ]
            [
                sh:datatype xsd:gYear
            ]
        ) ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P576, wdt:P582 ;
    ] ;
	sh:property [
        sh:path schema:width ;
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2049 ;
		sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path schema:height ;
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2048 ;
		sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path yago:length ;
        sh:datatype yago:UnitOfLength ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P2043 ;
    ] ;
	sh:property [
        sh:path yago:mass ;
		sh:maxCount 1 ;
        sh:datatype yago:UnitOfMass ;
        ys:fromProperty wdt:P2067 ;
    ] ;	
    sh:property [
        sh:path schema:material ;
        sh:class schema:BioChemEntity ;
        ys:fromProperty wdt:P186 ;
    ] ;
    sh:property [
        sh:path yago:creator ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P50, wdt:P170, wdt:P112 ; 
    ] ;
    sh:property [
        sh:path yago:area ; # Fabian: changed from schema: to yago: 2024-04-03
		sh:maxCount 1 ;
        sh:datatype yago:UnitOfArea ;
        ys:fromProperty wdt:P2046 ;
    ] ;
    sh:property [
        sh:path yago:highestPoint ; # Fabian: changed from schema: to yago: 2024-04-03
        sh:class schema:Place ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P610 ;
        rdfs:comment "The highest point of a Place"@en ;
    ] ;
    sh:property [
        sh:path yago:lowestPoint ; # Fabian: changed from schema: to yago: 2024-04-03
        sh:class schema:Place ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P1589 ;
        rdfs:comment "The lowest point of a Place"@en ;
    ] ;
    sh:property [
        sh:path yago:neighbor ; # Fabian: changed from schema: to yago: 2024-04-03
        sh:class schema:Place ;
        ys:fromProperty wdt:P47, wdt:P206 ;
        rdfs:comment "A neighboring Place"@en ;
    ] ;
    sh:property [
        sh:path yago:elevation ; # Fabian: changed from schema: to yago: 2024-04-03
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2044 ;
    ] .

# ------------------ Planets ---------------

# One permissible subclass of schema:Place is yago:AstronomicalObject
# We import all subclasses from Wikidata
yago:AstronomicalObject a sh:NodeShape ;
	rdfs:subClassOf schema:Place ;
	ys:fromClass wd:Q6999 ;
	sh:property [
        sh:path yago:parentBody ;
        sh:class yago:AstronomicalObject ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P397 ;
        rdfs:comment "The parent celestial body of an AstronomicalObject"@en ;
    ] ;    
	sh:property [
        sh:path schema:color ;
        ys:fromProperty wdt:P462 ;  
        sh:class yago:Color ;       
    ] ;	
	sh:property [
        sh:path yago:luminosity ;
        sh:datatype yago:UnitOfLuminosity ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2060 ;
        rdfs:comment "The luminosity of an AstronomicalObject"@en ;
    ] ;
    sh:property [
        sh:path yago:parallax  ;
        sh:datatype xsd:decimal ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2214 ;
        rdfs:comment "The parallax measurement of an AstronomicalObject"@en ;
    ] ;    
	sh:property [
        sh:path yago:radialVelocity  ;
        sh:datatype yago:UnitOfSpeed ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2216 ;
        rdfs:comment "The radial velocity of an AstronomicalObject"@en ;
    ] ;    
	sh:property [
        sh:path yago:distanceFromEarth ;
        sh:datatype yago:UnitOfLength ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2583 ;
        rdfs:comment "The distance of an AstronomicalObject from Earth"@en ;
    ] ;    
    sh:property [
        sh:path yago:temperature ;
        sh:datatype yago:UnitOfTemperature ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2076 ;
        rdfs:comment "Temperature of an Astronomical Object"@en ;
    ] .

# ------------------ Administrative Areas ---------------

# One permissible subclass of schema:Place is Administrative Area
# We import all subclasses from Wikidata
schema:AdministrativeArea a sh:NodeShape ;
	rdfs:subClassOf schema:Organization, schema:Place ;
	    sh:property [
        sh:path yago:populationNumber ; # Fabian: changed from schema:... 2024-04-03
        sh:datatype xsd:integer ;
		sh:maxCount 1 ;
        sh:minInclusive 0 ; 
        ys:fromProperty wdt:P1082 ;
        rdfs:comment "Population count"@en ;
    ] ;
    sh:property [
        sh:path yago:femalePopulation ;
        sh:datatype xsd:integer ;
		sh:maxCount 1 ;
        sh:minInclusive 0 ;
        ys:fromProperty wdt:P1539 ;
        rdfs:comment "Female population count"@en ;
    ] ;
    sh:property [
        sh:path yago:malePopulation ;
        sh:datatype xsd:integer ;
		sh:maxCount 1 ;
        sh:minInclusive 0 ;
        ys:fromProperty wdt:P1540 ;
        rdfs:comment "Male population count"@en ;
    ] ;	
    sh:property [
        sh:path yago:twinnedWith ;
        sh:class schema:Place ;
        ys:fromProperty wdt:P190 ;
        rdfs:comment "Twin place relationship (twinned administrative body)"@en ;
    ]  ;
    sh:property [
        sh:path yago:demonym ; # Fabian: changed from schema:... 2024-04-03
        sh:datatype rdf:langString ;
        ys:fromProperty wdt:P1549 ;
    ] ;
    sh:property [
        sh:path yago:capital ;
        sh:class schema:City ;
        ys:fromProperty wdt:P36 ;
        rdfs:comment "The capital City of an AdministrativeArea"@en ;
    ] ;
    sh:property [
        sh:path yago:marriageableAge ;
        sh:datatype xsd:integer ;
		sh:maxCount 1 ;
        sh:minInclusive 0 ;
        ys:fromProperty wdt:P3000 ;
        rdfs:comment "Age of consent in years"@en ;
    ] ;
    sh:property [
        sh:path yago:lifeExpectancy ;
		sh:maxCount 1 ;
        sh:datatype xsd:decimal ;    
        sh:minInclusive 0 ;
        ys:fromProperty wdt:P2250 ;
        rdfs:comment "Life expectancy in years"@en ;
    ] ;
    sh:property [
        sh:path yago:birthRate ;
		sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        ys:fromProperty wdt:P8763 ;
        rdfs:comment "Birth rate (live births per 1,000 inhabitants per year)"@en ;
    ] ;
    sh:property [
        sh:path yago:deathRate ;
		sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        ys:fromProperty wdt:P10091 ;
        rdfs:comment "Death rate (deaths per 1,000 inhabitants per year)"@en ;
    ] ;
    sh:property [
        sh:path yago:suicideRate ; 
		sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        ys:fromProperty wdt:P3864 ;
        sh:minInclusive 0 ;
        rdfs:comment "Amount of suicides per 100,000 people and year in the Country"@en ;
    ] ;
    sh:property [
        sh:path yago:unemploymentRate ; # Fabian: changed from schema:... 2024-04-03
        sh:datatype xsd:decimal ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P1198 ;
        rdfs:comment "Portion of a workforce population that is not employed"@en ;
    ] ;
    sh:property [
        sh:path yago:literacyRate ;
        sh:datatype xsd:decimal ;
		sh:maxCount 1 ;
        sh:minInclusive 0 ;
        sh:maxInclusive 100 ; 
        ys:fromProperty wdt:P6897 ;
        rdfs:comment "Literacy rate as percentage (0–100)"@en ;
    ] ; 
	sh:property [
            sh:path yago:totalFertilityRate ;
			sh:maxCount 1 ;
            sh:datatype xsd:decimal ;
            sh:minInclusive 0 ;
            ys:fromProperty wdt:P4841 ;
            rdfs:comment "Total fertility rate (children per woman)"@en ;
    ] ;
    sh:property [
        sh:path yago:vehicleOwnershipRate ;
        sh:datatype xsd:decimal ;
		sh:maxCount 1 ;
        sh:minInclusive 0 ;
        ys:fromProperty wdt:P5167 ;
        rdfs:comment "Number of vehicles per 1000 people"@en ;
    ] ;
    sh:property [
        sh:path schema:medianIncome ;
        sh:datatype yago:UnitOfMoney ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P3529 ;
        rdfs:comment "Median household income in a place"@en ;
    ] ;
    sh:property [
        sh:path yago:humanDevelopmentIndex ; # Fabian: changed from schema:humanDevelopmentIndex 2024-04-03
        sh:datatype xsd:decimal ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P1081 ;
        rdfs:comment "The Human Development Index value for a Country"@en ;
    ] ;
    sh:property [
        sh:path yago:studentsCount ;
        sh:datatype xsd:integer ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2196 ;
    ] ;
    ys:fromClass wd:Q56061, wd:Q486972 . # Fabian: also from human settlement, to avoid having it under land forms

# Needed for capitals, mapped to "City or Town" in Wikidata, and to City.
schema:City a sh:NodeShape ;
    rdfs:subClassOf schema:AdministrativeArea ;
    ys:fromClass wd:Q7930989, wd:Q515 .

# Needed because of additional properties
schema:Country a sh:NodeShape ;
	rdfs:subClassOf schema:AdministrativeArea ;
    sh:property [
        sh:path yago:inequalityAdjustedHumanDevelopmentIndex ; 
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P11593 ;
        rdfs:comment "The Inequality-adjusted Human Development Index value for a Country"@en ;
    ] ;
    sh:property [
        sh:path yago:BTIndex ; #Margherita 10/03/26: or bertelsmannTransformationIndex ?
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 10 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P8477, wdt:P8476 ; #Margherita 10/02/26: I think they are the same, not sure
        rdfs:comment "The Bertelsmann Transformation Index (BTI) value for a Country"@en ;
    ] ;
    sh:property [
        sh:path yago:democracyIndex ; 
        sh:datatype xsd:decimal ;
        ys:fromProperty wdt:P8328 ;
        sh:minInclusive 0 ;
        sh:maxInclusive 10 ;
		sh:maxCount 1 ;
        rdfs:comment "Democracy Index rating of a country"@en ;
    ] ;
    sh:property [
        sh:path yago:happyPlanetIndex ; 
        sh:datatype xsd:decimal ;
        ys:fromProperty wdt:P11547 ;
		sh:maxCount 1 ;
        rdfs:comment "The Happy Planet Index rating of a country"@en ;
    ] ;
    sh:property [
        sh:path yago:telephoneCountryCode ;
        sh:datatype xsd:string ;
        sh:pattern "^\\+\\d+$" ;
        ys:fromProperty wdt:P474 ;
        rdfs:comment "Telephone country calling code, format: +<digits>"@en ;
    ] ;
    sh:property [
        sh:path yago:ageOfMajority ;
		sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        ys:fromProperty wdt:P2997 ;
        rdfs:comment "Age of majority in years"@en ;
    ] ;
    ys:fromClass wd:Q6256, wd:Q3024240 . # Also: historical countries


# --------------------- Land Forms ------------------------

# One permissible subclass of schema:Place are land forms,
# from terrain, landmass, Landform, geographical area, natural geographic object
# not from geographical region (Q82794) and geographic location  (Q2221906) because otherwise many administrative regions become Landforms
schema:Landform a sh:NodeShape ;
    rdfs:subClassOf schema:Place ;
	ys:fromClass wd:Q14524493, wd:Q205895, wd:Q271669, wd:Q3622002, wd:Q35145263 ;
    sh:property [
        sh:path schema:location ;
        sh:or ([sh:class schema:Place] [sh:class schema:Organization ]) ;
		# Fabian: wdt:P361 is overloaded with partOf, to make countries part of continents etc.
		# Fabian: wdt:P463 is overloaded with memberOf
        ys:fromProperty wdt:P131 , wdt:P276 , wdt:P706 , wdt:P4552, wdt:P17, wdt:P30, wdt:P551, wdt:P361, wdt:P463, wdt:P183, wdt:P9714 ;
    ]  .
    
# Bodies of water are Landforms.
# Linked to body of water and marine body of water and lake
schema:BodyOfWater a sh:NodeShape ;
	rdfs:subClassOf schema:Landform ;
    ys:fromClass wd:Q15324, wd:Q116126039, wd:Q23397, wd:Q355304 ;
    sh:property [
        sh:path yago:flowsInto ;
        sh:class schema:BodyOfWater ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P403, wdt:P201 ;
        rdfs:comment "The BodyOfWater that another body of water flows into"@en ;
    ] .

# Continents
schema:Continent a sh:NodeShape ;
    rdfs:subClassOf schema:Landform ;
    ys:fromClass wd:Q5107 .


# -------------------- Human-made Places --------------------

# One permissible subclass of schema:Place are human made places.
# Mapped to "architectural structure" and Human Made Feature (twice...) in Wikidata.
# We thus import all subclasses from Wikidata here, 
# and need to define classes only to define properties
yago:HumanMadeGeographicalEntity a sh:NodeShape ;
	rdfs:subClassOf schema:Place ;
	rdfs:label "Human-made geographical entity"@en ;
    ys:fromClass wd:Q811979, wd:Q811430, wd:Q811463, wd:Q35145743, wd:Q811430, wd:Q18247357, wd:Q699405, wd:Q684740, wd:Q699405, wd:Q12292478, wd:Q1497375, wd:Q845132, wd:Q1403389, wd:Q1403389, wd:Q975783, wd:Q15642541, wd:Q839954, wd:Q17350442 ;
   sh:property [
        sh:path schema:location ;
        sh:or ([sh:class schema:Place] [sh:class schema:Organization ]) ;
		# Fabian: wdt:P361 is overloaded with partOf, to make countries part of continents etc.
		# Fabian: wdt:P463 is overloaded with memberOf
        ys:fromProperty wdt:P131 , wdt:P276 , wdt:P706 , wdt:P4552, wdt:P17, wdt:P30, wdt:P551, wdt:P361, wdt:P463, wdt:P183, wdt:P9714 ;
    ]  
   sh:property [
        sh:path schema:postalCode ;
        sh:datatype xsd:string ;
        ys:fromProperty wdt:P281 ;
    ] ;
	sh:property [
        sh:path schema:address ;
        sh:datatype xsd:string ;
        ys:fromProperty wdt:P6375 ;
    ] ;
   sh:property [
        sh:path schema:color ;
        ys:fromProperty wdt:P462 ;  
        sh:class yago:Color ;       
    ] ;	
        sh:property [
        sh:path schema:manufacturer ;
        sh:class schema:Organization ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P176 ;
        rdfs:comment "The manufacturer of a CreativeWork or Product"@en ;
    ] ;
    sh:property [
        sh:path yago:beliefSystem ;
        sh:class yago:BeliefSystem ; 
        ys:fromProperty wdt:P140, wdt:P1142 ;
    ] ; 
    sh:property [
        sh:path yago:ownedBy ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P127 ;
    ] ;
    sh:property [
        sh:path yago:studentsCount ;
        sh:datatype xsd:integer ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2196 ;
    ] ;
    sh:property [
        sh:path schema:logo ;
        sh:datatype xsd:anyURI ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P154 ;
    ] ;
    sh:property [
        sh:path schema:maximumAttendeeCapacity ;
        sh:datatype xsd:integer ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P1083 ;
		rdfs:comment "The total number of individuals that may attend an event or venue"@en ;	
    ] .

# Transit routes such as roads and railways.
# Mapped to "thoroughfare" Wikidata (not a subclass of arch struc), 
# not existing in schema.org
yago:Way a sh:NodeShape ;
	rdfs:label "Way"@en ;	
	rdfs:subClassOf yago:HumanMadeGeographicalEntity ;
    ys:fromClass wd:Q83620 ;
	sh:property [
        sh:path yago:terminus ;
        sh:class schema:Place ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P609 ;
        rdfs:comment "A Place where a Way terminates"@en ;
    ] .

# Listed here to add properties, and attached to yago:HumanMadeGeographicalEntity to avoid schema:CivicStructure
schema:Airport a sh:NodeShape ;
    rdfs:subClassOf yago:HumanMadeGeographicalEntity ;
    ys:fromClass wd:Q1248784 ;
    sh:property [
        sh:path schema:iataCode ;
        sh:datatype xsd:string ;
		sh:pattern "^[A-Z0-9]{2,3}$" ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P238 ;
        rdfs:comment "The IATA code for an Airport or Airline"@en ;
    ] .

################################################################
#                Commercial Products
################################################################

# An individual product with a GTIN. 
# Mapping also Collectables and Goods
schema:Product a sh:NodeShape ;
	rdfs:subClassOf schema:Thing ;
	rdfs:label "Product"@en ;
    ys:fromClass wd:Q2424752, wd:Q2342494, wd:Q28877, wd:Q2184715 ;
    sh:property [
        sh:path schema:logo ;
        sh:datatype xsd:anyURI ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P154 ;
    ] ;
    sh:property [
        sh:path schema:manufacturer ;
        sh:class schema:Organization ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P176, wdt:P178 ;
        rdfs:comment "The manufacturer of a CreativeWork or Product"@en ;
    ] ;
    sh:property [
        sh:path schema:locationCreated ;
        sh:class schema:Place ;
        ys:fromProperty wdt:P495 ;
    ] ;	
	sh:property [
        sh:path schema:color ;
        ys:fromProperty wdt:P462 ;  
        sh:class yago:Color ;       
    ] ;	
	sh:property [
        sh:path schema:width ;
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2049 ;
		sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path schema:height ;
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2048 ;
		sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path yago:length ;
        sh:datatype yago:UnitOfLength ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P2043 ;
    ] ;
	sh:property [
        sh:path yago:mass ;
		sh:maxCount 1 ;
        sh:datatype yago:UnitOfMass ;
        ys:fromProperty wdt:P2067 ;
    ] ;	
    sh:property [
        sh:path schema:material ;
        sh:class schema:BioChemEntity ;
        ys:fromProperty wdt:P186 ;
    ] ;
    sh:property [
        sh:path schema:about ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P921 ;
    ] ;
	sh:property [
        sh:path schema:slogan ; 
        sh:datatype rdf:langString ;
        ys:fromProperty wdt:P1451 ;
    ] ;		
   sh:property [
        sh:path yago:creator ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P50, wdt:P170, wdt:P112 ; 
    ] ;
   sh:property [
        sh:path yago:ownedBy ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P127 ;
    ] ;
    sh:property [
        sh:path yago:influencedBy ;
        sh:class schema:Thing ;
        ys:fromProperty wdt:P737, wdt:P941 ;
    ] ;
	sh:property [
        sh:path schema:award ;
        sh:class yago:Award ;
        ys:fromProperty wdt:P166 ;
    ] ;	
    sh:property [
        sh:path schema:sponsor ;
        sh:or (
	 [ sh:class schema:Person ]
         [ sh:class schema:Organization ]
        ) ;
        ys:fromProperty wdt:P859 ;
    ] ;
    sh:property [
        sh:path schema:price ;
        sh:datatype yago:UnitOfMoney ;
        ys:fromProperty wdt:P2284 ;
        rdfs:comment "The published price listed or paid for a product (with unit of currency)"@en ;
    ] ;
    sh:property [
        sh:path schema:maximumAttendeeCapacity ;
        sh:datatype xsd:integer ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P1083 ;
    ]
    sh:property [
        sh:path schema:requiredMinAge ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2899 ;
    ] ;
    sh:property [
        sh:path schema:requiredMaxAge ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P4135 ;
    ] ;
    sh:property [
        sh:path schema:gtin ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{12,14}|\\d{8}$" ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P3962 ;
        rdfs:comment "The Global Trade Item Number for a Product"@en ;
    ] .

yago:coin a sh:NodeShape ;
    rdfs:subClassOf schema:Product ;
    ys:fromClass wd:Q113813711 .


################################################################
#                Animals and other organisms
################################################################

# We model every taxon not as a class, but as an instance.
# This is the only way in which we can make assertions about taxons
schema:Taxon a sh:NodeShape;
	rdfs:subClassOf schema:Thing ;
	rdfs:label "Taxon"@en ;
	sh:property [
        sh:path schema:parentTaxon ;
        sh:class schema:Taxon ;
        ys:fromProperty wdt:P171 ;
		sh:maxCount 1 ;
        rdfs:comment "The parent taxon of a Taxon in biological classification"@en ;
    ] ;
	sh:property [
        sh:path schema:color ;
        ys:fromProperty wdt:P462 ;  
        sh:class yago:Color ;       
    ] ;	
	sh:property [
        sh:path schema:width ;
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2049 ;
		sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path schema:height ;
        sh:datatype yago:UnitOfLength ;
        ys:fromProperty wdt:P2048 ;
		sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path yago:length ;
        sh:datatype yago:UnitOfLength ;
        sh:maxCount 1 ;
        ys:fromProperty wdt:P2043 ;
    ] ;
	sh:property [
        sh:path yago:mass ;
		sh:maxCount 1 ;
        sh:datatype yago:UnitOfMass ;
        ys:fromProperty wdt:P2067 ;
    ] ;	
	sh:property [
        sh:path yago:consumes ;
        sh:class schema:Taxon ;
        ys:fromProperty wdt:P1034 ;
        rdfs:comment "A Taxon that another Taxon consumes (predator-prey relationship)"@en ;
    ] ;
    #Margherita 23/06/2026 added property
    sh:property [
          sh:path yago:eggIncubationPeriod ;
          sh:datatype yago:UnitOfTime ;
          sh:maxCount 1 ;
          ys:fromProperty wdt:P7770 ;
          rdfs:comment "The egg incubation period of a Taxon"@en ;
    ] ;
    sh:property [
          sh:path yago:dielCycle ;
          sh:datatype rdf:langString ;
          sh:maxCount 1 ;
          ys:fromProperty wdt:P9566 ;
          rdfs:comment "The diel cycle of a Taxon"@en ;
    ] ;
	ys:fromClass wd:Q16521 .
	
################################################################
#                Medical entities
################################################################


# Thomas 27/03/26
schema:MedicalEntity a sh:NodeShape;
	rdfs:subClassOf schema:Thing ;
	rdfs:label "Medical entity"@en ;
	rdfs:comment "Any entity related to health (disease, treatment, examinations, etc.)"@en .

# Thomas 01/04/26
schema:MedicalSpecialty a sh:NodeShape;
	rdfs:subClassOf schema:MedicalEntity ;
	rdfs:label "Medical Speciality"@en ;
	rdfs:comment "Branch of medicine concerning a specific group of diseases or population"@en ;
	ys:fromClass wd:Q44597158 .

# Thomas 01/04/26
schema:MedicalProcedure a sh:NodeShape;
	rdfs:subClassOf schema:MedicalEntity ;
	rdfs:label "Medical Procedure"@en ;
	rdfs:comment "Medical procedure for diagnosis or treatment"@en ;
    sh:property [
        sh:path schema:requiredMinAge ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P2899 ;
        rdfs:comment "Minimum required age in years"@en ;
    ] ;
    sh:property [
        sh:path schema:requiredMaxAge ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
		sh:maxCount 1 ;
        ys:fromProperty wdt:P4135 ;
        rdfs:comment "Maximum required age in years"@en ;
    ] ;	
    sh:property [
        sh:path yago:medicalSpecialty ;
        sh:or (
            [ sh:class schema:MedicalSpecialty ]
            [ sh:class yago:AcademicDiscipline ]
	) ;
        ys:fromProperty wdt:P1995 ;
        rdfs:comment "Medical speciality of the entity"@en ;
    ] ;   
	ys:fromClass wd:Q179661, wd:Q5690807, wd:Q796194 .

# Thomas 01/04/26 # Medical conditions are classes
schema:MedicalCondition a sh:NodeShape;
	rdfs:subClassOf schema:MedicalEntity ;
	# Too few facts
	sh:property [
        sh:path yago:treatment ;
        sh:or (
            [ sh:class schema:MedicalProcedure ] 
            [ sh:class schema:BioChemEntity ]
	        [ sh:class schema:Product ]
        ) ;
        ys:fromProperty wdt:P2176, wdt:P924 ;
        rdfs:comment "Drug or therapy used for treatment"@en ;
    ] ;   
	sh:property [
        sh:path yago:medicalSpecialty ;
        sh:class schema:MedicalSpecialty ;
        ys:fromProperty wdt:P1995 ;
        rdfs:comment "Medical speciality of the entity"@en ;
    ] ;   
	# Too few facts
	sh:property [
        sh:path yago:symptom ;
        sh:class schema:MedicalCondition ;
        ys:fromProperty wdt:P780 ;
        rdfs:comment "Symptoms or signs of a medical condition"@en ;
    ] ;  
	sh:property [
        sh:path yago:hasCause ;
        ys:fromProperty wdt:P828 ;
        sh:class schema:Thing ;
    ] ;
	# Too few facts
	sh:property [
        sh:path yago:examination ;
        ys:fromProperty wdt:P923 ;
        sh:class schema:MedicalProcedure ; 
        rdfs:comment "Medical examination to diagnose the medical condition"@en ;
    ] ;
	sh:property [
        sh:path yago:afflicts ;
        ys:fromProperty wdt:P689 ;
        sh:class schema:Taxon ;
        rdfs:comment "Type of organism which a condition or disease afflicts"@en ;
    ] ;
	# Too few facts
	sh:property [
        sh:path yago:riskFactor ;
        ys:fromProperty wdt:P5642 ;
        sh:class schema:Thing ;
        rdfs:comment "Risk factor for this medical condition"@en ;
    ] ;
	rdfs:label "Medical Condition"@en ;
	rdfs:comment "Any condition that affects the normal functioning of a person or an animal"@en ;
	ys:fromClass wd:Q7189713, wd:Q1483951, wd:Q12136, wd:Q130753312, wd:Q87075524, wd:Q112193867 .


################################################################
#                Bio-chemical entities
################################################################


# Thomas 27/03/26 
schema:BioChemEntity a sh:NodeShape;
	rdfs:subClassOf schema:Thing ;
	# Too few facts
	sh:property [ 
        sh:path yago:interacts ;
        sh:class schema:BioChemEntity ;
        ys:fromProperty wdt:P769 ;
        rdfs:comment "Significant drug interaction"@en ;
    ] ;   
	sh:property [
        sh:path yago:chemicalStructure ;
        sh:datatype xsd:string ;
        ys:fromProperty wdt:P274 ;
        rdfs:comment "The chemical structure of the entity"@en ;
    ] ;
	sh:property [
        sh:path schema:color ;
        ys:fromProperty wdt:P462 ;  
        sh:class yago:Color ;       
    ] ;	
	sh:property [
        sh:path yago:mass ;
		sh:maxCount 1 ;
        sh:datatype yago:UnitOfMass ;
        ys:fromProperty wdt:P2067 ;
    ] ;	
    rdfs:label "Biological or chemical entity"@en ;
	rdfs:comment "Any biological, chemical, or biochemical entity. For example: a protein; a gene; a chemical; a synthetic chemical; a drug."@en ;
	ys:fromClass wd:Q43460564, wd:Q55568967, wd:Q10683158 .

################################################################
#                Time annotation
################################################################

ys:AnnotationPropertyShape a rdfs:Property ;
    rdfs:subPropertyOf sh:PropertyShape .

ys:startDateAnnotation a ys:AnnotationPropertyShape ;
    sh:path schema:startDate ;
    sh:or (
        [
            sh:datatype xsd:dateTime
        ]
        [
            sh:datatype xsd:date
        ]
        [
            sh:datatype xsd:gYearMonth
        ]
        [
            sh:datatype xsd:gYear
        ]
    ) ;
    sh:maxCount 1 ;
    ys:fromProperty wpq:P580 ;
    rdfs:comment "The start date of an Event"@en .

ys:endDateAnnotation a ys:AnnotationPropertyShape ;
    sh:path schema:endDate ;
    sh:or (
        [
            sh:datatype xsd:dateTime
        ]
        [
            sh:datatype xsd:date
        ]
        [
            sh:datatype xsd:gYearMonth
        ]
        [
            sh:datatype xsd:gYear
        ]
    ) ;
    sh:maxCount 1 ;
    ys:fromProperty wpq:P582 ;
    rdfs:comment "The end date of an Event"@en .
